{
  "name": "internet-speed-checker",
  "version": "1.0.0",
  "description": "SpeedPulse is a browser-based internet speed tester with an optional ASP.NET Core backend.",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "check:site": "npm test",
    "build:app": "esbuild src/script.ts --bundle --platform=browser --target=es2020 --outfile=main-files/bundle.js",
    "build:labs": "esbuild src/developer.ts --bundle --platform=browser --target=es2020 --outfile=main-files/bundle-dev.js",
    "build": "npm run build:app && npm run build:labs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  },
  "private": true
}
